# Copy to .env.local for local development.
#
# Only the two Supabase variables are required. The rest default to production values, so a
# deployment that omits them behaves exactly as production always has — the failure mode of a
# missing variable is "no change", not "subtly wrong".

# ── Required ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Environment ───────────────────────────────────────────────────────────────
# production | staging | development. When unset it is inferred from the hostname, and only a
# recognised production host counts as production, so an unlabelled deploy shows the staging
# banner rather than passing itself off as the real thing.
# VITE_APP_ENV=development

# ── Hosts ─────────────────────────────────────────────────────────────────────
# Where the public site and the authenticated product live. Set these on any deployment that
# is not production, or sign-out will send people to the production marketing site.
#
# Production (the defaults):
#   VITE_MARKETING_HOSTS=campcommand.app,www.campcommand.app
#   VITE_APP_HOST=app.campcommand.app
#
# Staging:
#   VITE_MARKETING_HOSTS=staging.campcommand.app
#   VITE_APP_HOST=app-staging.campcommand.app
