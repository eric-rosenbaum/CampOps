    "That code has expired, request a new one.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código venció; pide uno nuevo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פג תוקף הקוד, יש לבקש קוד חדש."
          }
        }
      }
    },
    "That code isn't right. Check it and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código no es correcto. Revísalo e inténtalo de nuevo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקוד שגוי. כדאי לבדוק ולנסות שוב."
          }
        }
      }
    },
    "That email or password doesn't match an account.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese correo o contraseña no coincide con ninguna cuenta."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדוא״ל או הסיסמה לא תואמים לחשבון."
          }
        }
      }
    },
    "That join code isn't valid. Check it and try again.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese código de ingreso no es válido. Revísalo e inténtalo de nuevo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קוד ההצטרפות אינו תקף. כדאי לבדוק ולנסות שוב."
          }
        }
      }
    },
    "That photo doesn't show enough to go on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa foto no muestra lo suficiente."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התמונה לא מראה מספיק."
          }
        }
      }
    },
    "That sticker": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa etiqueta"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדבקה הזו"
          }
        }
      }
    },
    "That sticker belongs to %@. You are signed in to another camp.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa etiqueta es de %@. Tienes la sesión iniciada en otro campamento."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדבקה שייכת ל־%@. החיבור הנוכחי הוא למחנה אחר."
          }
        }
      }
    },
    "That sticker is not recognised. It may have been reprinted.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se reconoce esa etiqueta. Puede que la hayan reimpreso."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המדבקה לא מזוהה. ייתכן שהודפסה מחדש."
          }
        }
      }
    },
    "The microphone is off for CampCommand. Turn it on in Settings, or type it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono está desactivado para CampCommand. Actívalo en Ajustes, o escríbelo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון כבוי עבור CampCommand. אפשר להפעיל אותו בהגדרות, או להקליד."
          }
        }
      }
    },
    "The microphone isn't ready. You can still type it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono no está listo. Igual puedes escribirlo."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המיקרופון לא מוכן. עדיין אפשר להקליד."
          }
        }
      }
    },
    "The server rejected this change.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor rechazó este cambio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת דחה את השינוי."
          }
        }
      }
    },
    "The server sent a response the app could not read.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor envió una respuesta que la app no pudo leer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת שלח תשובה שהאפליקציה לא הצליחה לקרוא."
          }
        }
      }
    },
    "There are steps left. Tick them off and it closes itself.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quedan pasos. Márcalos y se cerrará sola."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשארו שלבים. אחרי סימון כולם הקריאה תיסגר מעצמה."
          }
        }
      }
    },
    "There is nothing to read yet. Take a photo, or record what is wrong.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada que leer. Toma una foto o graba qué pasa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין מה לקרוא. אפשר לצלם, או להקליט מה הבעיה."
          }
        }
      }
    },
    "These changes are still on this phone. They were not saved to the camp's records.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos cambios siguen en este teléfono. No se guardaron en los registros del campamento."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השינויים האלה עדיין בטלפון. הם לא נשמרו ברשומות המחנה."
          }
        }
      }
    },
    "This account is currently paused. Please reach out and we'll get you back up and running.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta está en pausa. Escríbenos y la reactivamos."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החשבון מושהה כרגע. אפשר לפנות אלינו ונחזיר אותו לפעילות."
          }
        }
      }
    },
    "This camp does not have the Campground module switched on.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campamento no tiene activado el módulo de Instalaciones."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודול השטח אינו מופעל במחנה הזה."
          }
        }
      }
    },
    "This camp isn't accepting new staff right now.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este campamento no está aceptando personal nuevo ahora."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המחנה לא מקבל אנשי צוות חדשים כרגע."
          }
        }
      }
    },
    "This cannot be undone.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לבטל את הפעולה."
          }
        }
      }
    },
    "This device can't scan": {
      "localizations": {
        "es": {
          "stringUnit": {
